# ============================================================================
# BlackBox Vault - .gitignore (blindagem)
# Objetivo: NUNCA versionar segredos, dependencias ou builds.
# ============================================================================

# --- Dependencias ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build / cache do Next.js ---
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# --- SEGREDOS: env files (NUNCA comitar) ---
.env
.env.*
!.env.example
*.local

# --- Vercel ---
.vercel

# --- Testes / cobertura ---
/coverage

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# --- Sistema / editores ---
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/

# --- Config local de agentes ---
.claude/

# --- Backups locais ---
/backups/
/.ui_backup/

# --- Scripts temporarios de manutencao ---
_*.ps1
.tmp-*.py